# ═══════════════════════════════════════════════
# ScholarFlow Merged - Unified Environment Config
# ═══════════════════════════════════════════════

# 1. CORE API & RECOGNITION
NODE_ENV=production
PORT=5000
# Used by backend for CORS and Redirects
FRONTEND_URL=https://scholarflow-web.onrender.com
# Used by backend as a fallback for OAuth redirection
BACKEND_URL=https://scholarflow-api.onrender.com

# 2. FRONTEND PUBLIC (Next.js)
# Required during build time for frontend
NEXT_PUBLIC_API_URL=https://scholarflow-api.onrender.com

# 3. SHARED DATABASE (Existing Supabase)
# DATABASE_URL is preferred for PostgreSQL pooling
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=SkyFlow_Db
DB_USER=postgres
DB_PASSWORD=your_db_password

# 4. UNIFIED GOOGLE AUTH (New Cloud Console Project)
GOOGLE_CLIENT_ID=307113428688-44su829qll7kjfph8vg1gfemumt8qrmp.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
# Must match Google Cloud Console Exactly
GOOGLE_REDIRECT_URI=https://scholarflow-api.onrender.com/api/auth/google/callback

# 5. SHARED INTEGRATIONS
GEMINI_API_KEY=your_gemini_key
RESEND_API_KEY=your_resend_key
RESEND_FROM_EMAIL=ScholarFlow <onboarding@resend.dev>

# 6. AUTHENTICATION & SECURITY
JWT_SECRET=your_long_random_jwt_secret
SESSION_SECRET=your_random_session_secret
LOG_LEVEL=info
