# ═══════════════════════════════════════════════
# ScholarFlow Merged - Unified Environment Config
# ═══════════════════════════════════════════════

# 1. CORE API URLS
PORT=5000
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:5000
NODE_ENV=development

# 2. SHARED DATABASE (Supabase)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# 3. UNIFIED GOOGLE AUTH (New Cloud Console Project)
GOOGLE_CLIENT_ID=PLACEHOLDER_NEW_ID
GOOGLE_CLIENT_SECRET=PLACEHOLDER_NEW_SECRET
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
GOOGLE_SERVICE_ACCOUNT_KEY={}

# 4. REUSED CREDENTIALS
GEMINI_API_KEY=YOUR_EXISTING_GEMINI_KEY
RESEND_API_KEY=YOUR_EXISTING_RESEND_KEY

# 5. SHARED JWT
JWT_SECRET=YOUR_UNIFIED_JWT_SECRET
